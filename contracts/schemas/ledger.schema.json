{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledger",
  "description": "Per-task run ledger written by deterministic code (shared-node/ledger.mjs). Must agree with validateLedger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "seq", "sha", "kind", "taskType", "owner", "task", "plan", "configHash", "policy", "stage", "stages", "gates", "tests", "commits", "retries", "spend", "stop", "needsHuman"],
  "properties": {
    "v": { "const": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kind": { "enum": ["code", "plan", "publish", "refresh"] },
    "taskType": { "type": ["string", "null"] },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "lastSeen"],
      "properties": {
        "sessionId": { "type": ["string", "null"] },
        "lastSeen": { "type": ["string", "null"] }
      }
    },
    "task": { "type": "string" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title"],
      "properties": {
        "path": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitConfigHash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the bytes of .pairingbuddy/git-config.json recorded at pb run open, after the file is bootstrapped. May be absent on ledgers written before it existed." },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source"],
      "properties": {
        "mode": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "runId", "attempt"],
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "startedAt": {
          "description": "ISO 8601 time the gate last marked this stage active, or null. May be absent.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" }
          ]
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "gates": { "type": "object" },
    "tests": { "type": "object" },
    "commits": { "type": "array", "items": { "type": "string" } },
    "runId": { "description": "Identifies this pb run (task) for its whole life; written once by pb run open and never changed. Not the same as stage.runId, which is the workflow run of the current stage attempt. May be absent on older ledgers.", "type": "string", "minLength": 1 },
    "checkpoints": {
      "description": "Each pb checkpoint that went through, a step with no change included. May be absent.",
      "type": "array",
      "items": { "type": "object" }
    },
    "retries": { "type": "object" },
    "spend": {
      "type": "object",
      "required": ["agents", "tokens"],
      "properties": {
        "agents": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "stop": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "seq", "code"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "seq": { "type": "integer", "minimum": 0 },
            "code": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "needsHuman": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate", "reason", "seq"],
          "properties": {
            "gate": { "type": "string", "minLength": 1 },
            "reason": { "type": "string" },
            "seq": { "type": "integer", "minimum": 0 },
            "shown": {
              "description": "What gate eval showed the human at G:publish: the HEAD sha, the unit base and the PR target. May be absent. A publish answer is refused if HEAD is no longer headSha.",
              "type": "object",
              "additionalProperties": false,
              "required": ["headSha", "base", "target"],
              "properties": {
                "headSha": { "type": "string", "minLength": 1 },
                "base": { "type": "string" },
                "target": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "voidedGates": {
      "description": "Gate approvals that stopped holding (G:publish after HEAD or the body moved), oldest first, kept for the audit trail. May be absent. record is the gate record as it stood; reason says what changed.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "record", "reason"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "record": { "type": "object" },
          "reason": { "type": "string" }
        }
      }
    },
    "lenses": {
      "description": "Lens records by name (the one the publish gate reads is \"safety-net\"). `pb stage finish` on a safety-net stage writes \"safety-net\": the stage, the attempt, the lenses that ran with their models, the counts of surviving, refuted and unrefuted findings, and the names of uncovered lenses. It holds no finding content. May be absent.",
      "type": "object",
      "properties": {
        "safety-net": {
          "type": "object",
          "properties": {
            "stage": { "type": "string" },
            "attempt": { "type": "integer" },
            "lenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "name": { "type": "string" }, "model": { "type": "string" } }
              }
            },
            "survivors": { "type": "integer", "minimum": 0 },
            "refuted": { "type": "integer", "minimum": 0 },
            "unrefuted": { "type": "integer", "minimum": 0 },
            "uncovered": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "additionalProperties": { "type": "object" }
    },
    "fixes": {
      "description": "Fix bookkeeping. rollbacks lists each rolled-back fix group, oldest first: its key, kind (commit, red, artifact or repeated, the last for a fix that repeated an approach already rolled back), the rollback ref that keeps the rejected work, sha (the commit that ref points at: the fix commit, or the commit holding the saved dirty paths), and base (HEAD after the rollback). ref is a string for kind commit or red, and for kind repeated when the fix changed something; it is null for kind artifact, which records no git ref, and for kind repeated when the fix changed nothing. May be absent; when present it has rollbacks and no other keys.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rollbacks"],
      "properties": {
        "rollbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "kind", "ref", "sha", "base"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["commit", "red", "artifact", "repeated"] },
              "ref": { "type": ["string", "null"] },
              "sha": { "type": ["string", "null"] },
              "base": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "acceptances": {
      "description": "Each hand edit a human accepted with pb human accept, oldest first. May be absent. oldSha is the sha the edited file carried; newSha is the sha of the content as edited, before the acceptance was added; seq is the seq the acceptance wrote.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oldSha", "newSha", "seq"],
        "properties": {
          "oldSha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "newSha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "seq": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "configAcceptances": {
      "description": "Each changed test-config a human accepted with pb human accept, oldest first. May be absent. oldHash is the configHash the run held, newHash the one it holds from then on, and seq the seq the acceptance wrote.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["oldHash", "newHash", "seq"],
        "properties": {
          "oldHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "newHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "seq": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
