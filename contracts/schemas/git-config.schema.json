{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Git Config",
  "description": "Human-owned git settings in .pairingbuddy/git-config.json. Defaults are written on first use; unknown keys are kept.",
  "type": "object",
  "properties": {
    "remote": { "type": "string" },
    "protected_branches": { "type": "array", "items": { "type": "string" } },
    "branch_template": { "type": "string" },
    "config_globs": { "type": "array", "items": { "type": "string" } },
    "commit": {
      "type": "object",
      "properties": {
        "red_commits": { "type": "boolean" },
        "subject_template": { "type": "string" },
        "key_pattern": { "type": ["string", "null"] },
        "require_signature": { "type": "boolean" },
        "conventions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "pr": {
      "type": "object",
      "properties": {
        "title_template": { "type": "string" },
        "base_branch": { "type": ["string", "null"] },
        "publish": { "type": "string" },
        "stack_depth": { "type": "integer" },
        "lint": { "type": "object" },
        "conventions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
